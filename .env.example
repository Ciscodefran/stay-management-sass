# ============================================================================
# Supabase 설정
# ============================================================================

# ----------------------------------------------------------------------------
# 로컬 개발 환경 (주석 해제하여 사용)
# ----------------------------------------------------------------------------
# supabase start 실행 후 아래 값 사용

# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

# ----------------------------------------------------------------------------
# 프로덕션 환경 (Supabase Cloud)
# ----------------------------------------------------------------------------
# Supabase Dashboard에서 아래 값을 복사하여 Vercel Environment Variables에 추가

# 1. Project URL
# Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# 2. Anon/Public Key
# Supabase Dashboard > Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Database Connection (Pooler) ⚠️ 중요!
# Supabase Dashboard > Settings > Database > Connection Pooling
# Transaction mode pooler (포트 6543) URL을 복사하세요
#
# ⚠️ Vercel Serverless에서는 반드시 Pooler URL을 사용해야 합니다!
# Direct connection (포트 5432)은 연결 고갈 문제가 발생합니다.
#
# 형식:
DATABASE_URL="postgresql://postgres.[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 예시:
# DATABASE_URL="postgresql://postgres.AbCdEfGhIjKlMnOp@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ============================================================================
# Vercel 배포 시 설정 방법
# ============================================================================
#
# 1. Vercel Dashboard > Project > Settings > Environment Variables
# 2. 위 3개 변수를 모두 추가:
#    - NEXT_PUBLIC_SUPABASE_URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - DATABASE_URL (Pooler URL)
#
# 3. Environment: Production, Preview, Development 모두 체크
#
# ============================================================================
# 참고사항
# ============================================================================
#
# - DATABASE_URL은 반드시 Transaction mode pooler 사용 (포트 6543)
# - ?pgbouncer=true 파라미터 필수
# - Session mode pooler (포트 5432)는 사용하지 마세요
# - 로컬 개발 시에는 supabase start 후 127.0.0.1 주소 사용
