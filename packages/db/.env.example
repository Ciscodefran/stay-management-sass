# ============================================================================
# 데이터베이스 연결 설정
# ============================================================================

# 로컬 개발 환경 (Supabase Local)
# supabase start 실행 후 사용
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ============================================================================
# 프로덕션 환경 (Supabase Cloud)
# ============================================================================

# Vercel Serverless에서는 반드시 Supabase Pooler를 사용해야 합니다!
#
# Supabase Dashboard > Settings > Database > Connection Pooling에서 확인
# Transaction mode pooler URL (포트 6543)을 복사하세요.
#
# 형식:
# DATABASE_URL="postgresql://postgres.[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# 예시:
# DATABASE_URL="postgresql://postgres.AbCdEfGhIjKlMnOp@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ⚠️ 중요 사항:
# - Transaction mode 사용 (포트 6543, ?pgbouncer=true 필수)
# - Session mode는 사용하지 마세요 (포트 5432)
# - Direct connection도 Serverless에서는 사용하지 마세요

# ============================================================================
# 로컬에서 Pooler 테스트 (선택사항)
# ============================================================================

# supabase/config.toml에서 [db.pooler] enabled = true로 설정 후:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres"
