{
  "name": "stay-management-sass",
  "version": "1.0.0",
  "private": true,
  "description": "Stay Management SaaS Monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @stay/db db:generate",
    "db:migrate": "pnpm --filter @stay/db db:migrate",
    "db:push": "pnpm --filter @stay/db db:push",
    "db:studio": "pnpm --filter @stay/db db:studio",
    "db:seed": "pnpm --filter @stay/db db:seed"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
